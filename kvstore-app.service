[Unit]
Description=KVStore React App and API Server
After=network.target
Wants=network.target

[Service]
Type=exec
User=mod
Group=mod
WorkingDirectory=/home/mod/Dev/React/ukvs/project
Environment=NODE_ENV=production
ExecStart=/usr/bin/bun run start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kvstore-app

[Install]
WantedBy=multi-user.target